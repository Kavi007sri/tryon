# ── Option A: Vertex AI (Google Cloud, works with the $300 free trial) ──
# Used when GOOGLE_CLOUD_PROJECT is set.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GOOGLE_APPLICATION_CREDENTIALS=./gcp-key.json

# ── Option B: Gemini Developer API key (aistudio.google.com) ──
# Used only when GOOGLE_CLOUD_PROJECT is empty.
GEMINI_API_KEY=

# Optional: force a model (defaults: gemini-nano-banana-2.1 → gemini-3-pro-image → gemini-2.5-flash-image)
# GEMINI_MODEL=gemini-nano-banana-2.1
